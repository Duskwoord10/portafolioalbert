CMS_PORT=8787
CMS_DB_PATH=.cms-data/cms.sqlite
CMS_DATA_BACKEND=sqlite
CMS_MEDIA_DIR=.cms-data/media
CMS_MEDIA_BACKEND=local
# Para pruebas de staging AWS; no activar sin infraestructura y credenciales autorizadas.
CMS_S3_BUCKET=
CMS_DYNAMODB_TABLE=
CMS_MIGRATION_APPLY=
CMS_BACKUP_DIR=.cms-backups
CMS_EXPORT_DIR=.cms-exports
CMS_RESTORE_DIR=.cms-restores
# Generar 32 bytes aleatorios hexadecimales y guardar fuera del repositorio; obligatorio en producción.
CMS_TOTP_ENCRYPTION_KEY=
CMS_PUBLIC_ORIGIN=http://localhost:5173
CMS_ADMIN_ORIGIN=http://localhost:5173
CMS_SITE_URL=https://albertsanfle.com
# Identidad SES verificada; sin valor en local, la recuperación por correo responde 503.
CMS_RECOVERY_FROM_EMAIL=
CMS_CHATBOT_FUNCTION_ARN=
VITE_CMS_API_URL=http://localhost:8787
